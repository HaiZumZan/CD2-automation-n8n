    {
      "parameters": {
        "jsCode": "let inputData = {};\nif ($input.first() && $input.first().json && $input.first().json.owner_username) {\n  inputData = $input.first().json;\n}\nconst ownerUsername = $('Parse Chat Data').item.json.owner_username;\n\nlet isBanned = inputData.is_banned === true || inputData.is_banned === 'true';\nlet count = Number(inputData.message_count || 0);\nlet dailyCount = Number(inputData.daily_count || 0);\nlet violationCount = Number(inputData.violation_count || 0);\n\nlet lastTime = inputData.last_message_time ? new Date(inputData.last_message_time) : new Date(0);\nlet lastDailyTime = inputData.last_daily_time ? new Date(inputData.last_daily_time) : new Date(0);\n\nlet isSpam = false; let isOverDaily = false;\nconst now = new Date();\n\nif (isBanned) {\n  return { owner_username: ownerUsername, message_count: count, daily_count: dailyCount, violation_count: violationCount, last_message_time: lastTime.toISOString(), last_daily_time: lastDailyTime.toISOString(), is_spam: true, is_over_daily: false, is_banned: true };\n}\n\nconst isSameDay = now.getDate() === lastDailyTime.getDate() && now.getMonth() === lastDailyTime.getMonth() && now.getFullYear() === lastDailyTime.getFullYear();\n\nif (!isSameDay) { dailyCount = 1; } else { dailyCount += 1; }\nif (dailyCount > 20) { isOverDaily = true; }\n\nconst diffMinutes = (now - lastTime) / (1000 * 60);\nif (diffMinutes > 1) {\n  count = 1;\n} else {\n  count += 1;\n  if (count > 5) {\n    isSpam = true;\n    if (count === 6) { violationCount += 1; }\n  }\n}\n\nif (violationCount >= 5) { isBanned = true; }\n\nreturn { owner_username: ownerUsername, message_count: count, daily_count: dailyCount, violation_count: violationCount, last_message_time: now.toISOString(), last_daily_time: now.toISOString(), is_spam: isSpam, is_over_daily: isOverDaily, is_banned: isBanned };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -912,
        608
      ],
      "id": "0ccffc9d-9e5f-4220-b439-488cdb0c1c2c",
      "name": "Code in JavaScript"
    },
