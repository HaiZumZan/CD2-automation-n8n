        "operation": "executeQuery",
        "query": "INSERT INTO rate_limits (owner_username, message_count, daily_count, violation_count, is_banned, last_message_time, last_daily_time) \nVALUES ('{{$json.owner_username}}', {{$json.message_count}}, {{$json.daily_count}}, {{$json.violation_count}}, {{$json.is_banned}}, '{{$json.last_message_time}}', '{{$json.last_daily_time}}') \nON CONFLICT (owner_username) \nDO UPDATE SET message_count = EXCLUDED.message_count, daily_count = EXCLUDED.daily_count, violation_count = EXCLUDED.violation_count, is_banned = EXCLUDED.is_banned, last_message_time = EXCLUDED.last_message_time, last_daily_time = EXCLUDED.last_daily_time;",
