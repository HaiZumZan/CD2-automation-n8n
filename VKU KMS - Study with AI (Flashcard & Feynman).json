    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response \n         || $input.first().json.output \n         || $input.first().json.text \n         || '';\n\nconsole.log(\"Raw output:\", raw);\n\n// Thử parse JSON array chuẩn trước\nconst matchArray = raw.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\nif (matchArray) {\n  try {\n    const parsed = JSON.parse(matchArray[0]);\n    const flashcards = parsed.map(item => ({\n      question: item.question || item.term || item.Term || Object.values(item)[0] || '',\n      answer:   item.answer || item.definition || item.Definition || Object.values(item)[1] || ''\n    }));\n    return [{ json: { flashcards } }];\n  } catch(e) {\n    console.log(\"Parse array of objects thất bại:\", e.message);\n  }\n}\n\n// Fallback: xử lý format lỗi [\"term\",\"definition\"] mỗi dòng\nconst lineMatches = raw.match(/\\[\"[^\"]+\",\\s*\"[^\"]+\"\\]/g);\nif (lineMatches && lineMatches.length > 0) {\n  try {\n    const flashcards = lineMatches.map(line => {\n      const pair = JSON.parse(line);\n      return { question: pair[0], answer: pair[1] };\n    });\n    return [{ json: { flashcards } }];\n  } catch(e) {\n    console.log(\"Parse fallback thất bại:\", e.message);\n  }\n}\n\n// Không parse được gì cả\nreturn [{ json: { error: 'JSON parse lỗi', raw } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
