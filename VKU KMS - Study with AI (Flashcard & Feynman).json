      "id": "41aa72f2-18a7-4e8e-ba63-84ff1c789f3b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Node: \"Decode Params\"\nconst body = $input.first().json.body;\n\nconst decode = (val) => {\n  if (!val) return '';\n  try { return decodeURIComponent(val); } \n  catch(e) { return val; }\n};\n\nreturn [{\n  json: {\n    body: {\n      ...body,\n      file_name: decode(body.file_name),\n      faculty:   decode(body.faculty),\n      major:     decode(body.major),\n      subject:   decode(body.subject),\n      owner_username: body.owner_username,\n      task:      body.task,\n      student_message: body.student_message || ''\n    }\n  }\n}];"
      },
